<Window x:Class="SsmsSqlFormatter.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formatted SQL Preview" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox Name="PreviewText" Grid.Row="0" Margin="8" FontFamily="Consolas" FontSize="12"
                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" IsReadOnly="False" />

        <RichTextBox Name="DiffText" Grid.Row="0" Margin="8" FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True" IsDocumentEnabled="False" Visibility="Collapsed" />

        <DockPanel Grid.Row="1" Margin="8" LastChildFill="False">
            <CheckBox Name="ShowDiffCheckBox" Content="Show differences" VerticalAlignment="Center"
                      DockPanel.Dock="Left" Checked="ShowDiffCheckBox_Changed" Unchecked="ShowDiffCheckBox_Changed" />
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Name="ApplyButton" Width="90" Margin="4" Click="ApplyButton_Click">Apply</Button>
                <Button Name="CloseButton" Width="90" Margin="4" Click="CloseButton_Click">Close</Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
